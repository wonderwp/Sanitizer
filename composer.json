{
  "name": "wonderwp/sanitizer",
  "description": "WonderWp Sanitizer Component",
  "type": "library",
  "keywords": ["sanitizer", "security", "WonderWp","WordPress"],
  "homepage": "https://github.com/wonderwp/Sanitizer",
  "license": "MIT",
  "authors": [
    {
      "name": "Jeremy Desvaux",
      "homepage": "https://jdmweb.com"
    },
    {
      "name": "WonderWp Community",
      "homepage": "http://wonderwp.net/Contribution/Contributors.html"
    }
  ],
  "require": {
    "php": "^8.3",
    "wonderwp/dependency-injection": "dev-feature/php_8"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {"WonderWp\\Component\\Sanitizer\\": "src"},
    "exclude-from-classmap": [
      "/tests/"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "WonderWp\\Component\\Sanitizer\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml.dist"
  },
  "minimum-stability": "dev"
}
